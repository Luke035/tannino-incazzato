# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# .claude is shared (agents, settings.json) — but local overrides stay out
.claude/settings.local.json
.agents

# dependencies
/node_modules
frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
frontend/coverage

# next.js
/.next/
frontend/.next/
/out/

# production
/build

# python
backend/.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design handoff — mockups kept locally, not in repo
design_handoff_tannino_incazzato/

# OpenCode runtime config — local, machine-specific. The QA agent itself lives
# in .claude/agents/qa-sommelier.md (committed); these only re-point OpenCode at
# it and pin its model, which is a per-machine provider choice.
opencode.json
.opencode/

# question bank data is not distributed with the repository
backend/data/question_bank.csv
backend/data/denomination_sweep_candidates.csv
backend/data/denomination_sweep_verdicts.csv
