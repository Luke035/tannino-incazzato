GEMINI_API_KEY=your_key_here
DATABASE_URL=postgresql://sommelier:sommelier@localhost:5432/sommelier_db

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Cookie security ───────────────────────────────────────────────────────────
# Used by: backend — sets the Secure flag on the session cookie.
# false for local HTTP dev; MUST be true in production behind HTTPS.
COOKIE_SECURE=false

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Setup steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or select an existing one)
#   3. APIs & Services → OAuth consent screen
#      - User type: External
#      - Fill in app name ("Sommelier Italia"), support email, developer email
#      - Scopes: add "email" and "profile"
#      - Test users: add your email while the app is in Testing mode
#   4. APIs & Services → Credentials → Create Credentials → OAuth client ID
#      - Application type: Web application
#      - Authorized redirect URIs: http://localhost:8000/auth/google/callback
#        (add your production URI here when deploying)
#   5. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL the backend redirects to after Google OAuth callback
FRONTEND_URL=http://localhost:3000

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Email promoted to admin at boot, but only when no admin exists at all. It
# never demotes and never overrides a decision made in the panel; the account
# must already have registered. Leave unset for a deployment with no bootstrap
# admin. See ADR 0014.
INITIAL_ADMIN_EMAIL=
