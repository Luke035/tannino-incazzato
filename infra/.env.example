# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by: db, backend (DATABASE_URL is constructed from these in docker-compose)
POSTGRES_USER=sommelier
POSTGRES_PASSWORD=sommelier
POSTGRES_DB=sommelier_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Used by: backend (signing) + frontend (proxy.ts verification) — must be identical
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── Gemini ────────────────────────────────────────────────────────────────────
# Used by: backend
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Used by: backend
# Setup: https://console.cloud.google.com/ → APIs & Services → Credentials
# GOOGLE_REDIRECT_URI must match the URI registered in Google Console exactly.
# With Docker + nginx, the callback goes through nginx (port 80), not directly
# to the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# ── URLs ──────────────────────────────────────────────────────────────────────
# Used by: backend — redirect target after Google OAuth callback completes
FRONTEND_URL=http://localhost

# ── CORS ──────────────────────────────────────────────────────────────────────
# Used by: backend
# In Docker + nginx, all browser requests are same-origin so CORS is not
# triggered. This value only matters when calling FastAPI directly (e.g. via
# start.sh for hot-reload development).
CORS_ORIGINS=http://localhost:3000
